// =====================================================================
// POLYPHONIC SYNTH ENGINE (Timer1 Interrupt)
// =====================================================================
ISR(TIMER1_COMPA_vect) {
  if (step1) {
    phase1 += step1;
    if (phase1 & 0x8000) *out1 |= mask1;
    else *out1 &= ~mask1;
  } else {
    *out1 &= ~mask1;
  }

  if (step2) {
    phase2 += step2;
    if (phase2 & 0x8000) *out2 |= mask2;
    else *out2 &= ~mask2;
  } else {
    *out2 &= ~mask2;
  }

  if (step3) {
    phase3 += step3;
    if (phase3 & 0x8000) *out3 |= mask3;
    else *out3 &= ~mask3;
  } else {
    *out3 &= ~mask3;
  }
}

uint16_t freqToStep(uint16_t freq) {
  if (freq == 0) return 0;
  return (uint16_t)(((uint32_t)freq * 65536UL) / 15625UL);
}

void setChord(uint16_t f1, uint16_t f2, uint16_t f3) {
  uint16_t s1 = freqToStep(f1);
  uint16_t s2 = freqToStep(f2);
  uint16_t s3 = freqToStep(f3);
  noInterrupts();
  step1 = s1;
  step2 = s2;
  step3 = s3;
  if (s1 == 0) phase1 = 0;
  if (s2 == 0) phase2 = 0;
  if (s3 == 0) phase3 = 0;
  interrupts();
}

void startSynth() {
  noInterrupts();
  TCCR1A = 0;
  TCCR1B = 0;
  TCNT1  = 0;
  OCR1A  = 127; // 16 MHz / (8 * 128) = 15,625 Hz sample rate
  TCCR1B |= (1 << WGM12) | (1 << CS11);
  TIMSK1 |= (1 << OCIE1A);
  interrupts();
}

void stopSynth() {
  noInterrupts();
  TIMSK1 &= ~(1 << OCIE1A);
  TCCR1B = 0;
  step1 = step2 = step3 = 0;
  phase1 = phase2 = phase3 = 0;
  *out1 &= ~mask1;
  *out2 &= ~mask2;
  *out3 &= ~mask3;
  interrupts();
}

void playPolyphonicSong(
  const uint16_t v1[],
  const uint16_t v2[],
  const uint16_t v3[],
  const uint16_t durations[],
  int count
) {
  startSynth();

  for (int i = 0; i < count; i++) {
    uint16_t f1  = pgm_read_word(&v1[i]);
    uint16_t f2  = pgm_read_word(&v2[i]);
    uint16_t f3  = pgm_read_word(&v3[i]);
    uint16_t dur = pgm_read_word(&durations[i]);

    if (f1 == REST && f2 == REST && f3 == REST) {
      setChord(0, 0, 0);
      digitalWrite(LED_PIN, LOW);
      delay(dur);
    } else {
      digitalWrite(LED_PIN, HIGH);
      setChord(f1, f2, f3);
      delay(dur - 25);

      setChord(0, 0, 0);
      digitalWrite(LED_PIN, LOW);
      delay(25); // Crisp piano key release between chords
    }
  }

  stopSynth();
}

// =====================================================================
// DISTANCE SENSOR
// =====================================================================
float readDistanceCm() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);

  if (duration == 0) {
    return -1;
  }

  return duration * 0.0343 / 2;
}

// =====================================================================
// SETUP & LOOP
// =====================================================================
void setup() {
  Serial.begin(9600);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(SPEAKER1_PIN, OUTPUT);
  pinMode(SPEAKER2_PIN, OUTPUT);
  pinMode(SPEAKER3_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);

  digitalWrite(LED_PIN, LOW);

  // Cache fast port registers for the 3 speakers
  out1  = portOutputRegister(digitalPinToPort(SPEAKER1_PIN));
  mask1 = digitalPinToBitMask(SPEAKER1_PIN);
  out2  = portOutputRegister(digitalPinToPort(SPEAKER2_PIN));
  mask2 = digitalPinToBitMask(SPEAKER2_PIN);
  out3  = portOutputRegister(digitalPinToPort(SPEAKER3_PIN));
  mask3 = digitalPinToBitMask(SPEAKER3_PIN);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    Serial.println(F("OLED not found!"));
    while (true);
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println(F("3-Speaker Piano"));
  display.println(F("Starting..."));
  display.display();

  delay(1000);
}

void loop() {
  float distance = readDistanceCm();

  display.clearDisplay();

  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println(F("Distance:"));

  display.setTextSize(3);
  display.setCursor(0, 18);

  if (distance < 0 || distance > MAX_DISTANCE_CM) {
    display.setTextSize(2);
    display.print(F("No object"));
    Serial.println(F("No object detected"));
  } else {
    display.print(distance, 1);
    display.setTextSize(1);
    display.print(F(" cm"));

    Serial.print(F("Distance: "));
    Serial.print(distance);
    Serial.println(F(" cm"));

    int barLength = map(
      (int)distance,
      0,
      MAX_DISTANCE_CM,
      SCREEN_WIDTH,
      0
    );

    barLength = constrain(barLength, 0, SCREEN_WIDTH);

    display.fillRect(
      0,
      SCREEN_HEIGHT - 8,
      barLength,
      6,
      SSD1306_WHITE
    );

    if (distance < WARNING_CM) {
      display.setTextSize(1);
      display.setCursor(80, 0);
      display.print(F("CLOSE!"));
    }
  }

  display.display();

  // TRIGGER WHEN 50 cm <= x <= 200 cm
  bool inZone = (distance >= TRIGGER_MIN_CM && distance <= MAX_DISTANCE_CM);

  if (inZone && !wasInZone) {
    Serial.println(F("50cm+ DETECTED - Clair de Lune (3-Voice Piano)"));
    int clairCount = sizeof(clairDur) / sizeof(clairDur[0]);
    playPolyphonicSong(clairV1, clairV2, clairV3, clairDur, clairCount);

    delay(500);

    // Note: If you meant Jingle Bells when x < 50 cm instead of x >= 50 cm,
    // move this block outside into: if (distance > 0 && distance < TRIGGER_MIN_CM)
    Serial.println(F("Playing Jingle Bells (3-Voice Harmony)"));
    int jingleCount = sizeof(jingleDur) / sizeof(jingleDur[0]);
    playPolyphonicSong(jingleV1, jingleV2, jingleV3, jingleDur, jingleCount);
  }

  wasInZone = inZone;
  digitalWrite(LED_PIN, LOW);

  delay(100);
}
